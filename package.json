{
  "name": "megatravel-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dup": "jscpd --threshold 3 --exit-code 1 src",
    "knip": "knip",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run dup && npm run knip && npm test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jscpd": "^5",
    "knip": "^6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
